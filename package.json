{
  "name": "ledgerly",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update": "LEDGERLY_VISUAL=1 playwright test --project=chromium --project=mobile-chrome --update-snapshots",
    "test:e2e:visual": "LEDGERLY_VISUAL=1 playwright test --project=chromium --project=mobile-chrome"
  },
  "devDependencies": {
    "jsdom": "30.1.2",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0"
  }
}
